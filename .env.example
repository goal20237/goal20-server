# GOAL20 server keys for runs on YOUR OWN PC only.
# 1. Copy this file and name the copy exactly:  .env   (in the same folder)
# 2. Paste each key after the = sign, no spaces, no quotes.
# 3. Never upload .env: it is in .gitignore, so git skips it.
# On GitHub the live server reads the same keys from
#   Settings -> Secrets and variables -> Actions (already saved there).

FOOTBALL_DATA_API_KEY=
FOOTBALL_CHARTS_KEY=
ODDSPAPI_KEY=

# Optional limits (defaults shown)
FETCH_EVERY_HOURS=6
MAX_CYCLES_PER_DAY=4
